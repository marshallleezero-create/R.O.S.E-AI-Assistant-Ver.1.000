# ROSE Configuration

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# LLM Configuration
LLM_PROVIDER=ollama  # options: ollama, openai, claude, gemini
LLM_MODEL=llama2  # local model name if using ollama
LLM_API_KEY=  # required if using cloud provider

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM Fallback
OPENAI_API_KEY=  # for GPT-4o when needed
CLAUDE_API_KEY=  # for Claude when needed

# Data & Storage
DB_PATH=./data/rose.db
DATA_DIR=./data
EXPERIMENTS_DIR=./experiments

# Speech & Vision (Phase 2+)
WHISPER_MODEL=base  # tiny, base, small, medium, large
TTS_ENGINE=piper  # options: piper, kokoro
VISION_MODEL=local  # options: local (LLaVA), openai, claude

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/rose.log
